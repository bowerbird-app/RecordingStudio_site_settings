<% dummy_page_nav(
  title: "Install",
  subtitle: "Add this gem so a host can store site name, logos, and tab icon outside core and outside the root.",
  back_url: root_path
) %>

<%= dummy_wide_logo_sidebar do %>
<div class="flex w-full flex-col gap-6">

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Add the gem",
    subtitle: "Pin Recording Studio and the majors this gem reads.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      gem "recording_studio_site_settings"
      gem "recording_studio", "~> 7.8", github: "bowerbird-app/RecordingStudio", tag: "v7.8.0"
      gem "recording_studio_accessible", "~> 0.58", github: "bowerbird-app/RecordingStudio_accessible", tag: "v0.58.0"
      gem "recording_studio_admin", "~> 2.20", github: "bowerbird-app/RecordingStudio_admin", tag: "v2.20.0"
      gem "recording_studio_api", "~> 1.21", github: "bowerbird-app/RecordingStudio_api", tag: "v1.21.2"
      gem "recording_studio_attachable", "~> 0.34", github: "bowerbird-app/RecordingStudio_attachable", tag: "v0.34.0"
      gem "recording_studio_icons", "~> 0.5", github: "bowerbird-app/RecordingStudio_icons", tag: "v0.5.0"
      gem "recording_studio_logs", "~> 0.9", github: "bowerbird-app/RecordingStudio_logs", tag: "v0.9.0", require: false
      gem "recording_studio_metrics", "~> 0.10", github: "bowerbird-app/RecordingStudio_metrics", tag: "v0.10.0"
      gem "recording_studio_moveable", "~> 6.1", github: "bowerbird-app/RecordingStudio_moveable", tag: "v6.1.0"
      gem "recording_studio_trashable", "~> 1.3", github: "bowerbird-app/RecordingStudio_trashable", tag: "v1.3.0", require: false
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Generate and migrate",
    subtitle: "Install this gem and Attachable. Core does not store name, logos, or favicon.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :bash,
    code: <<~CODE
      bin/rails generate recording_studio_site_settings:install
      bin/rails generate recording_studio_site_settings:migrations
      bin/rails generate recording_studio_attachable:install
      bin/rails generate recording_studio_attachable:migrations
      bin/rails db:migrate
    CODE
  ) %>
</div>
<% end %>
