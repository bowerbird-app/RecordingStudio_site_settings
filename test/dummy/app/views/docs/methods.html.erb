<% dummy_page_nav(title: "Methods", back_url: root_path) %>

<%= dummy_wide_logo_sidebar do %>
<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Other gems read name, logos, and favicon here. Do not call Attachable just to print a mark.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Read the name",
    subtitle: "RecordingStudioSiteSettings.name_for",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      root = RecordingStudio.root_recording_for(workspace)
      RecordingStudioSiteSettings.name_for(root)
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Read the square logo",
    subtitle: "RecordingStudioSiteSettings.square_logo_for",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      logo = RecordingStudioSiteSettings.square_logo_for(root)
      logo.preview_url
      logo.present?
      RecordingStudioSiteSettings.logo_for(root)
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Read the wide logo",
    subtitle: "RecordingStudioSiteSettings.wide_logo_for",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      logo = RecordingStudioSiteSettings.wide_logo_for(root)
      logo.preview_url
      logo.present?
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Read the favicon",
    subtitle: "RecordingStudioSiteSettings.favicon_for",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      favicon = RecordingStudioSiteSettings.favicon_for(root)
      favicon.preview_url
      favicon.present?
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Print the marks",
    subtitle: "recording_studio_site_square_logo and recording_studio_site_wide_logo",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      recording_studio_site_square_logo(current_root_recording)
      recording_studio_site_wide_logo(current_root_recording)
      recording_studio_site_logo(current_root_recording)
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Print the tab icon",
    subtitle: "recording_studio_site_favicon",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      recording_studio_site_favicon(current_root_recording)
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Write name, logos, and favicon",
    subtitle: "RecordingStudioSiteSettings.update!",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioSiteSettings.update!(
        root,
        name: "Studio",
        actor: current_user,
        square_logo_io: File.open("square-logo.png"),
        square_logo_filename: "square-logo.png",
        square_logo_content_type: "image/png",
        wide_logo_io: File.open("wide-logo.png"),
        wide_logo_filename: "wide-logo.png",
        wide_logo_content_type: "image/png",
        favicon_io: File.open("favicon.png"),
        favicon_filename: "favicon.png",
        favicon_content_type: "image/png"
      )
    CODE
  ) %>
</div>
<% end %>
