<%# Core default_layout puts data-theme on body. Named Flatpack themes
    belong on html so token aliases inherit correctly. %>
<script>
  document.documentElement.setAttribute("data-theme", "rounded");
</script>
<% site_root = RecordingStudioSiteSettings.site_root_for(controller) %>
<% if site_root.present? %>
  <%= recording_studio_site_favicon(site_root) %>
<% end %>
