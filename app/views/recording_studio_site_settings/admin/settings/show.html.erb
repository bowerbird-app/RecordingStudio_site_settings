<% recording_studio_page_nav(
  title: "Site name and logo",
  page_nav_anchor_url: main_app.root_path
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Site name and logo",
  subtitle: "Name, logo, and the icon in the browser tab.",
  variant: :h1
) %>

<%= render FlatPack::Grid::Component.new(cols: 2) do %>
  <div>
    <% if @site_setting_recording.present? %>
      <div class="mb-8">
        <p class="mb-2 text-sm font-medium text-(--surface-content-color)">Logo</p>
        <%= turbo_frame_tag "site-logo" do %>
          <div class="inline-flex items-end gap-3">
            <%= render FlatPack::Avatar::Component.new(
                  src: @logo.preview_url,
                  size: :"2xl",
                  shape: :square,
                  icon: "photo"
                ) %>
            <%= render_site_settings_file_button(
                  @site_setting_recording,
                  slot: "logo",
                  return_to: settings_path
                ) %>
          </div>
        <% end %>
      </div>

      <div class="mb-8">
        <p class="mb-1 text-sm font-medium text-(--surface-content-color)">Favicon</p>
        <p class="mb-2 text-sm text-(--surface-muted-content-color)">Browser tab.</p>
        <%= turbo_frame_tag "site-favicon" do %>
          <div class="inline-flex items-end gap-3">
            <%= render FlatPack::Avatar::Component.new(
                  src: @favicon.preview_url,
                  size: :xl,
                  shape: :square,
                  icon: "photo"
                ) %>
            <%= render_site_settings_file_button(
                  @site_setting_recording,
                  slot: "favicon",
                  return_to: settings_path
                ) %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= form_with url: settings_path, method: :patch do %>
      <%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg) do %>
        <%= render FlatPack::TextInput::Component.new(
          name: "site_setting[name]",
          label: "Site name",
          value: @name,
          required: true
        ) %>

        <div>
          <%= render FlatPack::Button::Component.new(text: "Save", type: "submit", style: :primary) %>
          <%= render FlatPack::Button::Component.new(
            text: "Cancel",
            style: :secondary,
            href: request.referer.presence || main_app.root_path
          ) %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
