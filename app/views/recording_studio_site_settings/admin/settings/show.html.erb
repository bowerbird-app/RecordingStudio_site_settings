<% recording_studio_page_nav %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Site name and logo",
  subtitle: "This is what people see when they arrive.",
  variant: :h1
) %>

<%= render FlatPack::Grid::Component.new(cols: 2) do %>
  <%= form_with url: settings_path, method: :patch, local: true, multipart: true do %>
    <%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg) do %>
      <%= render FlatPack::TextInput::Component.new(
        name: "site_setting[name]",
        label: "Site name",
        value: @name,
        required: true
      ) %>

      <% if @logo.present? %>
        <%= recording_studio_site_logo(@site_root, size: :"2xl") %>
      <% end %>

      <%= render FlatPack::FileInput::Component.new(
        name: "site_setting[logo]",
        label: "Logo",
        accept: "image/*",
        help_text: @logo.present? ? "Replace it with a new file if you like." : "No logo yet. Add a mark so people know they are in the right place."
      ) %>

      <div>
        <%= render FlatPack::Button::Component.new(text: "Save", type: :submit, style: :primary) %>
        <%= render FlatPack::Button::Component.new(
          text: "Cancel",
          style: :secondary,
          href: request.referer.presence || main_app.root_path
        ) %>
      </div>
    <% end %>
  <% end %>
<% end %>
